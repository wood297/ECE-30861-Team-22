# Settings for the app on the server. Nothing secret goes here, because this file is committed.
# Each release uses its own copy, so a rollback restores the settings that went with it.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=openai.gpt-oss-20b
CRA_BEDROCK_ENABLED=1
# Connection tokens for test_account.json are SSM parameters under this prefix, at
# <prefix>/orgs/<org_id>/conn/<connection id>. Until one is stored (and the instance role may read
# it, deploy/aws_tenant_setup.sh), that connection's categories are INACCESSIBLE, never a crash.
CRA_SECRET_PREFIX=/team22-cra
